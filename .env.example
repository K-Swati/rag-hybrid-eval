# Copy to .env. Everything works offline with the defaults below.

# Postgres, as the read-only role created by db/init/03_reader_role.sql
DATABASE_URL=postgresql://rag_reader:rag_reader@localhost:5432/icecream

# offline | openai. "openai" switches the router, the SQL writer and the answer generator to OpenAI.
LLM=offline
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Override one part only (optional)
ROUTER=                   # keywords | openai
SQL_WRITER=               # rules | openai
GENERATOR=                # extractive | openai

# Document search
EMBEDDINGS=hashing        # hashing | openai
EMBEDDING_MODEL=text-embedding-3-small
CHUNKING=heading          # heading | recursive | fixed
QDRANT_URL=               # empty = in-memory Qdrant

QUESTIONS_PATH=           # empty = data/eval/questions.json
REPORTS_DIR=              # empty = reports/
